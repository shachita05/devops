
pipeline {
    agent any

    environment {
        APP_DIR = 'exercise_9/python-flask-app'
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                dir("${APP_DIR}") {
                    sh '.venv/bin/python -m unittest discover -s . -p "test_*.py" -v'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    cp "$APP_DIR/app.py" "$DEPLOY_DIR/"
                    cp "$APP_DIR/requirements.txt" "$DEPLOY_DIR/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Running application...'
                sh '''
                    if [ -f "$DEPLOY_DIR/app.pid" ]; then
                        OLD_PID=$(cat "$DEPLOY_DIR/app.pid")
                        kill "$OLD_PID" 2>/dev/null || true
                    fi

                    cd "$DEPLOY_DIR"
                    nohup python3 app.py > app.log 2>&1 &
                    echo $! > app.pid
                    sleep 3

                    if ! kill -0 "$(cat app.pid)" 2>/dev/null; then
                        cat app.log
                        exit 1
                    fi
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing application...'
                dir("${APP_DIR}") {
                    sh '.venv/bin/python test_app.py'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }

        always {
            sh '''
                if [ -f "$DEPLOY_DIR/app.pid" ]; then
                    kill "$(cat "$DEPLOY_DIR/app.pid")" 2>/dev/null || true
                    rm -f "$DEPLOY_DIR/app.pid"
                fi
            '''
        }
    }
}
